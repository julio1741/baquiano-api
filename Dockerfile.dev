# syntax=docker/dockerfile:1
# Development image used by compose.yaml. Full ruby image (not slim) so
# native gems (pg, rgeo) build without extra apt-get steps on first run.

ARG RUBY_VERSION=3.3.12
FROM docker.io/library/ruby:${RUBY_VERSION}

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y libpq-dev postgresql-client && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

WORKDIR /rails

COPY Gemfile Gemfile.lock ./
RUN bundle install

COPY . .

ENTRYPOINT ["/rails/bin/docker-entrypoint"]

EXPOSE 3000
CMD ["bin/rails", "server", "-b", "0.0.0.0"]
