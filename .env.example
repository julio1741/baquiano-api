# Copy to .env and adjust if needed. docker compose reads this file
# automatically; none of these are required to start with the defaults below.

DATABASE_USERNAME=baquiano
DATABASE_PASSWORD=baquiano
DATABASE_NAME=baquiano_development

# Only needed if you want the container to read encrypted credentials
# instead of relying on the config/master.key file already on disk.
# RAILS_MASTER_KEY=
