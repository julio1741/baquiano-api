# Copy to .env and adjust if needed. docker compose reads this file
# automatically; none of these are required to start with the defaults below.

DATABASE_USERNAME=baquiano
DATABASE_PASSWORD=baquiano
DATABASE_NAME=baquiano_development

# Only needed if you want the container to read encrypted credentials
# instead of relying on the config/master.key file already on disk.
# RAILS_MASTER_KEY=

# Dev-only defaults already baked into compose.yaml; override here if you
# want your own. For a real environment, generate fresh ones with
# `bin/rails db:encryption:init` (Active Record Encryption) and a random
# 32+ byte string (BLIND_INDEX_PEPPER) — never reuse the dev values.
# AR_ENCRYPTION_PRIMARY_KEY=
# AR_ENCRYPTION_DETERMINISTIC_KEY=
# AR_ENCRYPTION_KEY_DERIVATION_SALT=
# BLIND_INDEX_PEPPER=
